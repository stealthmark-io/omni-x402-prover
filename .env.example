# Omni x402 Prover Environment Configuration Template
# All keys, addresses, and endpoints must be supplied via environment variables.
# 100% Non-Custodial: This service NEVER accepts, stores, or handles private keys.

# EVM Recipient Address on Base (Base USDC recipient)
# Default production builder payout address:
X402_PAY_TO_ADDRESS=0xc8dc4ecb93c4c665Fad07E1261F5f7D60e3C6E0F

# Target EVM Network: 'base' (mainnet) or 'base-sepolia' (testnet)
X402_NETWORK=base

# Base Mainnet USDC Contract Address (Default: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913, 6 decimals)
X402_ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# x402 Facilitator Settlement Endpoint
# Production default: PayAI Network Base Facilitator (https://facilitator.payai.network)
# Alternative: Coinbase CDP Facilitator (https://api.cdp.coinbase.com/platform/v2/x402, needs the CDP_API_KEY_* vars below)
X402_FACILITATOR_URL=https://facilitator.payai.network

# Optional static Bearer Token, sent only to X402_FACILITATOR_URL (not for Coinbase CDP: CDP uses the per-request JWT below)
# X402_FACILITATOR_BEARER_TOKEN=your_facilitator_token_here

# Secondary facilitator, tried when the primary fails with a connection error or HTTP 429/500/502/503/504
# (any other HTTP error from the primary is final). Default: Coinbase CDP.
X402_SECONDARY_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Coinbase CDP Secret API key, used only for https *.coinbase.com facilitators: the prover signs a fresh
# JWT per request (bound to method + host + path, valid 120 s). Nothing CDP-related is sent to other facilitators.
# CDP_API_KEY_SECRET accepts the Ed25519 key (base64) or the ECDSA key (PEM; literal \n line breaks are fine).
# Requires the Python 'cryptography' package. If either variable is missing or unusable, CDP requests go out
# without Authorization (Coinbase answers 401) and a warning without the values is logged.
# Put the real values in a root-only (0600) systemd EnvironmentFile, never in this file or in git.
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Mock facilitator flag for offline local development & demo without on-chain settlement (1 or 0)
X402_MOCK_FACILITATOR=0

# Payment Authorization Timeout in seconds (default: 60)
X402_MAX_TIMEOUT_SECONDS=60

# Per-Proof Pricing in Atomic Base USDC Units (6 decimals, 1 USDC = 1,000,000 units)
# Default: 20000 = $0.02 USDC
X402_PRICE_VAULT_ATOMIC=20000

# Default: 20000 = $0.02 USDC
X402_PRICE_POLYMARKET_ATOMIC=20000

# Default: 30000 = $0.03 USDC
X402_PRICE_ZK_BITVEC_ATOMIC=30000

# Default: 50000 = $0.05 USDC
X402_PRICE_DIFFERENTIAL_ATOMIC=50000
